# Copy to .env.local and fill in real values. Never commit .env.local.
# Keep this file in sync with lib/env.ts and AGENTS.md §5.5 (names + placeholders only).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret. NEVER expose via a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# HMAC key for OTP code hashes (lib/otp.ts, table otp_challenges). Dedicated key: do NOT reuse
# the Supabase JWT secret. At least 32 characters. Required in production; unset in dev = random
# key per server run (codes sent before a dev-server restart stop verifying).
OTP_SECRET=generate-a-long-random-string-at-least-32-chars

# --- Environment ---
# "production" turns on the strict checks in lib/env.ts (all secrets required, live PayMongo key).
# Vercel's VERCEL_ENV is used when this is unset.
APP_ENV=development

# --- Tenancy / admin ---
# website_roles.website_id used to scope user roles. Required for signup role assignment.
WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Email of the super-admin who receives platform notifications.
ADMIN_EMAIL=admin@example.com
# Admin console TOTP MFA (aal2 gate on /admin and on admin Server Actions).
# Unset = on when APP_ENV/VERCEL_ENV is production, off elsewhere. "false" in production is
# break-glass only (docs/RUNBOOK.md). Set "true" locally to test the enrol/verify flow.
ADMIN_MFA_REQUIRED=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (PayMongo). Without the secret key, payments are MOCKED as successful (dev only;
# production requires an sk_live_ key and the webhook secret). ---
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx

# --- Cron (Bearer token for /api/cron/escrow-release). At least 32 characters.
# Unset = the endpoint refuses every request. ---
CRON_SECRET=generate-a-long-random-string-at-least-32-chars

# --- Rate limiting (Upstash). Without these, rate limiting is disabled. ---
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Email (Resend). Without the key, emails are logged to the console. ---
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Travi Support <onboarding@resend.dev>"

# --- Monitoring (optional) ---
# Sentry is off when both DSNs are empty. Browser: NEXT_PUBLIC_SENTRY_DSN; server/edge: SENTRY_DSN
# (falls back to the public DSN).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
LOG_LEVEL=

# --- Sentry source maps (BUILD-TIME only; set in Vercel, read by next.config.ts, not lib/env.ts) ---
# All three are needed for source-map upload and release creation; otherwise uploads are skipped.
# The auth token is a secret (org token with project:releases scope).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- E2E (optional) ---
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000

# --- Scripts (do not keep in .env.local) ---
# Write-capable scripts/* refuse to run unless this equals the Supabase project ref, per run:
#   CONFIRM_DB_WRITE=your-project-ref npx tsx scripts/seed_tours.ts
